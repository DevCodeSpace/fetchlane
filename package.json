{
  "name": "fetchlane",
  "version": "1.0.0",
  "description": "Lightweight React data-fetching utility with caching, retry, and deduplication.",
  "main": "dist/fetchlane.umd.js",
  "module": "dist/fetchlane.es.js",
  "types": "index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {

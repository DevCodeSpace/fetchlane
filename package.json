  },
  "keywords": [
    "react",
    "react-hooks",
    "data-fetching",
    "api",
    "fetch",
    "react-query",
    "cache",
    "retry",
    "loader"
  ],
  "author": "DevCodeSpace",
  "license": "MIT",
  "homepage": "https://github.com/DevCodeSpace/fetchlane#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCodeSpace/fetchlane.git"
  },
  "bugs": {
    "url": "https://github.com/DevCodeSpace/fetchlane/issues"
  },
  "exports": {

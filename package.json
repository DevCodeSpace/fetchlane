{
  "name": "fetchlane",
  "version": "0.0.1",
  "description": "Lightweight React data-fetching utility with caching, retry, and deduplication.",
  "main": "dist/fetchlane.umd.js",
  "module": "dist/fetchlane.es.js",
  "types": "index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "react-hooks",
    "data-fetching",
    "api",
    "fetch",
    "react-query",
    "cache",
    "retry",
    "loader"
  ],
  "author": "DevCodeSpace",
  "license": "MIT",
  "homepage": "https://github.com/DevCodeSpace/fetchlane#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevCodeSpace/fetchlane.git"
  },
  "bugs": {
    "url": "https://github.com/DevCodeSpace/fetchlane/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/fetchlane.es.js",
      "require": "./dist/fetchlane.umd.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "vite": "^8.0.10"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "fdir": "^6.5.0",
    "fsevents": "^2.3.3",
    "lightningcss": "^1.32.0",
    "lightningcss-darwin-x64": "^1.32.0",
    "nanoid": "^3.3.12",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.14",
    "react": "^19.2.5",
    "rolldown": "^1.0.0-rc.17",
    "source-map-js": "^1.2.1",
    "tinyglobby": "^0.2.16"
  }
}
